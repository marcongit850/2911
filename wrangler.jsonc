{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 2911 Studio. Worker name is studio2911.
  // Contact mail uses Worker secrets RESEND_API_KEY and CONTACT_EMAIL.
  // Do not put those values in this file. Leave them unset until Marc sets them.
  // The sender stays on Resend's shared onboarding address. Do not add a sending domain here.
  // Do not add a custom domain or route in this file. DNS stays unset on purpose.
  "name": "studio2911",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/contact", "/api/contact/"]
  },
  // Required by `npx wrangler preview`. Keep this empty. Do not put secrets here.
  "previews": {}
}
